{
  "manifest_version": 3,
  "name": "Rang Nama",
  "version": "0.1.0",
  "description": "Does this suit you? Colour and print advice on Pakistani clothing, computed in your browser.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pk.khaadi.com/*",
    "https://www.junaidjamshed.com/*",
    "https://www.gulahmedshop.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pk.khaadi.com/*",
        "https://www.junaidjamshed.com/*",
        "https://www.gulahmedshop.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Rang Nama"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/wasm/*",
        "vendor/models/*"
      ],
      "matches": [
        "https://pk.khaadi.com/*",
        "https://www.junaidjamshed.com/*",
        "https://www.gulahmedshop.com/*"
      ]
    }
  ]
}
